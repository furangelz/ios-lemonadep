 	if (fbcon_base != NULL) {
 		register_serial_functions(&sweet_fbcon_serial_functions);
+		PE_parse_boot_argn("sweetbeat", &fbcon_beat_on, sizeof(fbcon_beat_on));
+		nanoseconds_to_absolutetime(250 * NSEC_PER_MSEC, &fbcon_beat_interval);
+	}
+}
+
+/*
+ * sweetbeat=1 heartbeat, called from sleh_irq for every virtual timer
+ * (source 0) and IPI (source 1) interrupt. Each source toggles its own
+ * 40x40 square near the top right corner (green: timer, blue: IPI) at most
+ * every 250 ms, so a blinking square means that source keeps interrupting
+ * and a steady or missing one that it stopped. Text that scrolls over a
+ * square hides it until its next toggle.
+ */
+void
+sweet_fbcon_beat(unsigned int source)
+{
+	static uint64_t next[2];
+	static uint32_t lit[2];
+
+	if (!fbcon_beat_on || fbcon_base == NULL || source > 1 || fbcon_width < 160 || fbcon_height < 100) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now < next[source]) {
+		return;
+	}
+	next[source] = now + fbcon_beat_interval;
+	lit[source] ^= 1;
+	uint32_t color = !lit[source] ? FBCON_BG : (source ? 0xff4080ffu : 0xff00ff00u);
+	uint32_t x0 = fbcon_width - 64 - source * 56, y0 = 48;
+	for (uint32_t y = y0; y < y0 + 40; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = x0; x < x0 + 40; x++) {
+			line[x] = color;
+		}
 	}
 }
 
